# NNN BRAND — Environment Configuration
# Copy to .env.local for local development or production deployment

# 1. PostgreSQL Connection (Used when running Prisma against external Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nnn_brand?schema=public"

# 2. Admin & Session Security
ADMIN_EMAIL="admin@nnnbrand.uz"
ADMIN_PASSWORD="NNNAdmin2026!"
SESSION_SECRET="nnn-brand-atelier-tashkent-secret-key-2026"

# 3. Uzbekistan Payment Gateways (Click & Payme)
# Leave empty to use transparent Sandbox/Verification mode; populate in production
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

# 4. Telegram Order Notifications Bot
# Populate TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID to send real-time order alerts to Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 5. Cloud Asset Storage (S3 / Cloudflare R2 / Supabase Storage base URL for GLB models)
NEXT_PUBLIC_ASSET_CDN_URL=""
